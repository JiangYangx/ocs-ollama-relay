# 统一换行符，消除 Windows 下的 CRLF 警告
* text=auto eol=lf

# Windows 批处理必须 CRLF，否则 cmd 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 源码与文档统一 LF
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.iss text eol=crlf
*.spec text eol=lf
*.txt text eol=lf

# 二进制，不做换行转换
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.zip binary
*.db binary
